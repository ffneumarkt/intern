# Example environment for FF Intern. Copy to /srv/intern/.env (mode 0600) on a server, or to a local .env
# for development. Never commit the real file (.env is in .gitignore).
#
# Local development: `set -a; . ./.env; set +a; make dev-api` (make dev-api already sets PASSKEY_RP_ID and PASSKEY_ORIGIN).
# Server: compose.yaml reads this file (env_file) for the app, and TUNNEL_TOKEN for cloudflared.

# --- Server only -------------------------------------------------------------------------------------------
# Cloudflare Zero Trust -> Networks -> Tunnels: a tunnel with the public hostname intern.ffneumarkt.at -> http://intern:8090.
TUNNEL_TOKEN=

# --- Web push (optional; without these keys the app runs but sends no push) --------------------------------
# A key pair: docker run --rm ghcr.io/ffneumarkt/intern vapid   (or: cd backend && go run ./cmd/intern vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: address or an https URL that the push services can reach you at.
VAPID_SUBJECT=mailto:you@example.com

# --- First start -------------------------------------------------------------------------------------------
# true: on the first start of an empty database, add the station's default categories, check types and locations
# (backend/internal/defaults/defaults.json). Harmless to leave on: it does nothing once a category exists.
# The first admin is made with `intern bootstrap --admin-email EMAIL --admin-name NAME`.
APPLY_DEFAULTS=false

# --- Behaviour (all optional) ------------------------------------------------------------------------------
# debug, info, warn or error.
LOG_LEVEL=info
# true: the PocketBase dashboard and admin API (/_/) answer through the tunnel too. Switch it on only while needed.
ADMIN_API_ALLOW=false
# Passkeys on any other site than intern.ffneumarkt.at: the site's domain, and the allowed origins (comma separated).
# PASSKEY_RP_ID=localhost
# PASSKEY_ORIGIN=http://localhost:5173,http://localhost:8090
