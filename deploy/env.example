# /srv/intern/.env (mode 0600). Never commit the real file.
TUNNEL_TOKEN=
# docker run --rm ghcr.io/ffneumarkt/intern vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: address or an https URL that the push services can reach you at.
VAPID_SUBJECT=mailto:
LOG_LEVEL=info
# true: on the first start of an empty database, add the station's default categories, check types and locations
# (backend/internal/defaults/defaults.json). Harmless to leave on: it does nothing once a category exists.
APPLY_DEFAULTS=false
